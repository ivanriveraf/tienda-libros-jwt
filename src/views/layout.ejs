<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Tienda de Libros JWT</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Share+Tech+Mono&display=swap"
    rel="stylesheet"
  />
  <style>
  /* ===== MATRIX THEME (CSS incrustado: a prueba de cache) ===== */
  :root {
    --matrix-green: #00ff88;
    --matrix-green-soft: #1aff9c;
    --matrix-green-dim: #0a8f55;
    --matrix-bg: #03070a;
    --matrix-bg-2: #050b0f;
    --matrix-panel: rgba(8, 22, 17, 0.82);
    --matrix-panel-solid: #06120e;
    --matrix-border: rgba(0, 255, 136, 0.32);
    --matrix-border-strong: rgba(0, 255, 136, 0.7);
    --matrix-text: #cdeede;
    --matrix-text-dim: #6fae93;
    --glow-sm: 0 0 6px rgba(0, 255, 136, 0.45);
    --glow-md: 0 0 14px rgba(0, 255, 136, 0.55);
    --glow-lg: 0 0 24px rgba(0, 255, 136, 0.7);
    --font-mono: 'Share Tech Mono', 'Courier New', monospace;
    --font-display: 'Orbitron', 'Share Tech Mono', sans-serif;
  }

  html, body { min-height: 100%; }
  body {
    font-family: var(--font-mono);
    background:
      radial-gradient(1200px 600px at 50% -10%, rgba(0, 255, 136, 0.06), transparent 60%),
      linear-gradient(180deg, var(--matrix-bg), var(--matrix-bg-2));
    background-attachment: fixed;
    color: var(--matrix-text);
    letter-spacing: 0.4px;
  }

  /* Scanlines suaves */
  body::after {
    content: "";
    position: fixed; inset: 0; z-index: 9999; pointer-events: none;
    background: repeating-linear-gradient(to bottom,
      rgba(0,0,0,0) 0, rgba(0,0,0,0) 2px, rgba(0,0,0,0.10) 3px, rgba(0,0,0,0) 4px);
    opacity: 0.5;
  }

  main, #globalMsg { position: relative; z-index: 1; }
  .navbar { position: sticky; top: 0; z-index: 20; }

  /* Tipografia */
  h1, h2, h3, .navbar-brand {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  .text-success, .text-success * { color: var(--matrix-green) !important; text-shadow: var(--glow-sm); }
  .lead, p { color: var(--matrix-text); }
  .text-secondary { color: var(--matrix-text-dim) !important; }
  a { color: var(--matrix-green); text-decoration: none; transition: color .2s ease, text-shadow .2s ease; }
  a:hover { color: var(--matrix-green-soft); text-shadow: var(--glow-md); }

  /* Navbar */
  .navbar, .navbar.bg-black {
    background: rgba(3,7,10,0.92) !important;
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--matrix-border) !important;
    box-shadow: 0 2px 18px rgba(0,255,136,0.1);
  }
  .navbar-brand { font-size: 1.4rem; text-shadow: var(--glow-md); }
  .navbar-brand::before { content: "> "; color: var(--matrix-green); }
  .nav-link { color: var(--matrix-text) !important; font-family: var(--font-display); font-size: .8rem; letter-spacing: 1px; transition: color .2s ease; }
  .nav-link:hover { color: var(--matrix-green) !important; text-shadow: var(--glow-sm); }

  /* Hero */
  .matrix-hero {
    border: 1px solid var(--matrix-border);
    background: var(--matrix-panel);
    border-radius: 14px;
    padding: 3rem 1.5rem;
    margin-top: 1rem;
    box-shadow: var(--glow-md), inset 0 0 40px rgba(0,255,136,0.04);
    backdrop-filter: blur(2px);
  }
  .matrix-hero h1 { font-size: clamp(1.8rem, 5vw, 3rem); }

  .type-cursor {
    display: inline-block; width: .55ch; background: var(--matrix-green);
    box-shadow: var(--glow-sm); animation: blink 1s steps(2) infinite;
    margin-left: 2px; color: transparent;
  }
  @keyframes blink { 0%,49%{opacity:1;} 50%,100%{opacity:0;} }

  /* Glitch */
  .glitch { position: relative; font-family: var(--font-display); color: var(--matrix-green); text-shadow: var(--glow-sm); }
  .glitch::before, .glitch::after { content: attr(data-text); position: absolute; left:0; top:0; width:100%; overflow:hidden; }
  .glitch::before { color:#00fff2; animation: glitch-x 2.6s infinite linear alternate-reverse; clip-path: inset(0 0 55% 0); }
  .glitch::after  { color:#ff003c; animation: glitch-x 3.2s infinite linear alternate-reverse; clip-path: inset(55% 0 0 0); }
  @keyframes glitch-x {
    0%{transform:translate(0);} 20%{transform:translate(-2px,1px);}
    40%{transform:translate(2px,-1px);} 60%{transform:translate(-1px,0);}
    80%{transform:translate(1px,1px);} 100%{transform:translate(0);}
  }

  /* Botones */
  .btn, .btn-success, .btn-outline-success, a.btn {
    border-radius: 8px; font-family: var(--font-display); font-weight: 500;
    text-transform: uppercase; letter-spacing: 1px; transition: all .2s ease;
  }
  .btn-success {
    background: rgba(0,255,136,0.08); border: 1px solid var(--matrix-green);
    color: var(--matrix-green); box-shadow: var(--glow-sm);
  }
  .btn-success:hover { background: var(--matrix-green); color:#03110a; box-shadow: var(--glow-lg); transform: translateY(-1px); }
  .btn-outline-success { border: 1px solid var(--matrix-border-strong); color: var(--matrix-green); }
  .btn-outline-success:hover { background: rgba(0,255,136,0.12); color: var(--matrix-green-soft); box-shadow: var(--glow-md); }

  /* Catalogo: grid de cards */
  .libros-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.3rem; margin-top: 1.2rem;
  }
  .libro-card {
    position: relative; display: flex; flex-direction: column;
    border: 1px solid var(--matrix-border); background: var(--matrix-panel);
    border-radius: 12px; padding: 1.3rem; overflow: hidden;
    backdrop-filter: blur(2px);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .libro-card::before {
    content: ""; position: absolute; top:0; left:0; width:100%; height:2px;
    background: linear-gradient(90deg, transparent, var(--matrix-green), transparent); opacity:.6;
  }
  .libro-card:hover { transform: translateY(-5px); border-color: var(--matrix-border-strong); box-shadow: var(--glow-md); }
  .libro-card .libro-id { font-size: .72rem; color: var(--matrix-text-dim); letter-spacing: 1px; }
  .libro-card .libro-titulo {
    font-family: var(--font-display); font-weight: 700; font-size: 1.1rem;
    color: var(--matrix-green); text-shadow: var(--glow-sm);
    margin: .35rem 0 .15rem; line-height: 1.25;
  }
  .libro-card .libro-autor { color: var(--matrix-text-dim); font-size: .9rem; margin-bottom: 1rem; }
  .libro-card .libro-meta {
    display: flex; justify-content: space-between; align-items: baseline;
    border-top: 1px dashed var(--matrix-border);
    padding-top: .8rem; margin-top: auto; margin-bottom: 1rem;
  }
  .libro-card .libro-precio { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; color: var(--matrix-green-soft); text-shadow: var(--glow-sm); }
  .libro-card .libro-stock { font-size: .8rem; color: var(--matrix-text-dim); }

  /* Form de compra: input + boton proporcionados */
  .libro-card .formCompra { display: flex; gap: .6rem; align-items: stretch; }
  .libro-card .formCompra input {
    width: 70px; flex: 0 0 70px; text-align: center; font-weight: 600;
    font-size: 1rem; padding: .45rem .3rem;
  }
  .libro-card .formCompra .btn { flex: 1 1 auto; padding: .45rem 1rem; font-size: .85rem; white-space: nowrap; }

  /* Badge sin stock ocupa toda la fila inferior */
  .libro-card .badge.bg-danger { width: 100%; padding: .6rem; font-size: .85rem; }

  /* Inputs terminal */
  .form-label { color: var(--matrix-text-dim); text-transform: uppercase; font-size: .78rem; letter-spacing: 1.5px; }
  .form-control {
    background: rgba(0,0,0,0.55) !important; border: 1px solid var(--matrix-border);
    color: var(--matrix-green) !important; font-family: var(--font-mono);
    caret-color: var(--matrix-green); border-radius: 6px;
  }
  .form-control:focus { background: rgba(0,0,0,0.7) !important; border-color: var(--matrix-green); box-shadow: var(--glow-md); color: var(--matrix-green-soft) !important; }
  .form-control::placeholder { color: var(--matrix-text-dim); opacity: .6; }

  /* Panel login/registro */
  .auth-panel {
    border: 1px solid var(--matrix-border); background: var(--matrix-panel);
    border-radius: 12px; padding: 2rem;
    box-shadow: var(--glow-md), inset 0 0 30px rgba(0,255,136,0.03);
    backdrop-filter: blur(2px); margin-top: 1.5rem;
  }
  .auth-panel h2::before { content: "[ "; color: var(--matrix-green-dim); }
  .auth-panel h2::after  { content: " ]"; color: var(--matrix-green-dim); }

  /* Alertas */
  .alert { font-family: var(--font-mono); border-radius: 8px; background: var(--matrix-panel-solid); }
  .alert-success { border: 1px solid var(--matrix-green); color: var(--matrix-green); box-shadow: var(--glow-sm); }
  .alert-danger  { border: 1px solid #ff003c; color: #ff5277; box-shadow: 0 0 10px rgba(255,0,60,0.35); }
  .alert-warning { border: 1px solid #ffcc00; color: #ffd84d; box-shadow: 0 0 10px rgba(255,204,0,0.3); }
  .alert-info    { border: 1px solid var(--matrix-border); color: var(--matrix-green); }
  .badge.bg-danger { background: transparent !important; border: 1px solid #ff003c; color: #ff5277 !important; box-shadow: 0 0 8px rgba(255,0,60,0.35); }

  /* Spinner */
  .spinner-matrix { color: var(--matrix-green); border-color: var(--matrix-green); border-top-color: transparent; box-shadow: var(--glow-sm); animation: matrix-pulse .8s ease-in-out infinite; }
  @keyframes matrix-pulse {
    0%{transform:scale(1);opacity:.9;box-shadow:0 0 6px rgba(0,255,136,.6);}
    50%{transform:scale(1.15);opacity:1;box-shadow:0 0 16px rgba(0,255,136,.9);}
    100%{transform:scale(1);opacity:.9;box-shadow:0 0 6px rgba(0,255,136,.6);}
  }

  /* Scrollbar / seleccion */
  ::-webkit-scrollbar { width: 10px; }
  ::-webkit-scrollbar-track { background: #03070a; }
  ::-webkit-scrollbar-thumb { background: var(--matrix-green-dim); border-radius: 8px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--matrix-green); }
  ::selection { background: var(--matrix-green); color: #03110a; }

  /* Responsive */
  @media (max-width: 576px) {
    .matrix-hero { padding: 2rem 1rem; }
    .auth-panel { padding: 1.4rem; }
    .libros-grid { grid-template-columns: 1fr; }
  }
  </style>
</head>
<body class="bg-dark text-light">
  <!-- Lluvia de codigo Matrix (fondo fijo) -->
  <canvas id="matrix-rain"
    style="position:fixed; top:0; left:0; width:100vw; height:100vh; z-index:-1; pointer-events:none; opacity:0.22;">
  </canvas>

  <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-success">
    <div class="container-fluid">
      <a class="navbar-brand text-success" href="/">Tienda Libros</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto" id="navLinks">
          <li class="nav-item"><a href="/libros" class="nav-link">Libros</a></li>
          <li class="nav-item"><a href="/login" class="nav-link">Login</a></li>
          <li class="nav-item"><a href="/registro" class="nav-link">Registro</a></li>
          <li class="nav-item"><a href="#" class="nav-link" onclick="logout(event)">Logout</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <%- body %>
  </main>

  <div class="container mt-2" id="globalMsg"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
  function logout(e) {
    if (e) e.preventDefault();
    const msg = document.getElementById('globalMsg');
    const token = localStorage.getItem('token');
    if (!token) {
      msg.innerHTML = `
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
          <strong>No hay sesion activa.</strong> Inicia sesion para acceder a la tienda.
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>`;
      return;
    }
    localStorage.removeItem('token');
    msg.innerHTML = `
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Sesion cerrada correctamente.</strong> Gracias por visitar la Tienda de Libros.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>`;
    setTimeout(() => { window.location.href = '/'; }, 1500);
  }
  </script>

  <script>
  function renderNav() {
    const nav = document.getElementById('navLinks');
    const token = localStorage.getItem('token');
    if (token) {
      nav.innerHTML = `
        <li class="nav-item"><a href="/libros" class="nav-link">Libros</a></li>
        <li class="nav-item"><a href="#" class="nav-link text-warning" onclick="logout(event)">Cerrar sesion</a></li>`;
    } else {
      nav.innerHTML = `
        <li class="nav-item"><a href="/libros" class="nav-link">Libros</a></li>
        <li class="nav-item"><a href="/login" class="nav-link">Login</a></li>
        <li class="nav-item"><a href="/registro" class="nav-link">Registro</a></li>`;
    }
  }
  renderNav();
  </script>

  <!-- Lluvia Matrix -->
  <script>
  (function () {
    const canvas = document.getElementById('matrix-rain');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    Object.assign(canvas.style, {
      position: 'fixed', top: '0', left: '0',
      width: '100vw', height: '100vh',
      zIndex: '-1', pointerEvents: 'none', opacity: '0.22'
    });

    const glyphs = 'アイウエオカキクケコサシスセソタチツテトナニヌネノ0123456789ABCDEF<>/{}[]=$#*';
    const fontSize = 16;
    let columns, drops;

    function setup() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      columns = Math.floor(canvas.width / fontSize);
      drops = new Array(columns).fill(1).map(() => Math.floor(Math.random() * (canvas.height / fontSize)));
    }
    function draw() {
      ctx.fillStyle = 'rgba(3, 7, 10, 0.08)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.font = fontSize + "px 'Share Tech Mono', monospace";
      for (let i = 0; i < drops.length; i++) {
        const text = glyphs.charAt(Math.floor(Math.random() * glyphs.length));
        const x = i * fontSize, y = drops[i] * fontSize;
        if (Math.random() > 0.975) { ctx.fillStyle = '#d6ffe9'; ctx.shadowColor = '#00ff88'; ctx.shadowBlur = 8; }
        else { ctx.fillStyle = '#00ff88'; ctx.shadowBlur = 0; }
        ctx.fillText(text, x, y);
        ctx.shadowBlur = 0;
        if (y > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }
    setup();
    let interval = setInterval(draw, 50);
    let resizeTimer;
    window.addEventListener('resize', function () { clearTimeout(resizeTimer); resizeTimer = setTimeout(setup, 150); });
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { clearInterval(interval); } else { interval = setInterval(draw, 50); }
    });
  })();
  </script>
</body>
</html>
